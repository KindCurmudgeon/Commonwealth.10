@page "/"
@using Commonwealth.Client.Services
@using Commonwealth.Shared.EndpointDTOs;
@using Commonwealth.Client.Components
@using IdentityProvider.EndpointDTOs
@using Identity.Client.Service
@inject NavigationManager NavMgr;
@inject ApiService ApiService;
@inject IdentityService IdentityService;
@inject SharedDataService DataService;
@namespace Commonwealth.Client.Pages

<style>
    body {
        background-color: aliceblue
    }
</style>
<div class="container">
    <div class="row">
        <div class="col-6">

            <label class="col-form-label">Username:</label>
            <div>
                <input type="text" @bind-value="AuthProfileDTO!.UserName" class="form-control" />
            </div>

            <label class="col-form-label">Password:</label>
            <div>
                <input type="password" @bind-value="@AuthProfileDTO.Password" class="form-control" />
            </div>
            @* <div class="">
                <button class="btn btn-primary mt-3" onclick="@SigninSubmitAsync">Submit</button>
            </div> *@
            <div class="">
                <button class="btn btn-primary mt-3" onclick="@OnSigninSubmit">Submit Creds</button>
            </div>
            <div class="">
                <div class="clicktext mt-3" onclick="@RegisterClicked">Create New Account</div>
            </div>
        </div>

        <div class="col-6 d-flex justify-content-center">
            <img src="SplashWelcome.png" alt="welcome" class="image-fluid mb-4 mx-auto d-block"
                 style="max-width: 100%; height:auto" />
        </div>
    </div>

    <FormEntryErrorMessages ErrorMessages="Errors" />
    <UserPopup @ref="UserPopupRef" OnSubmit="RegisterSubmit" />
</div>

@code {
    // private void NewAccount() { NavMgr.NavigateTo(PageLink.User); }
    private AuthProfileDTO? AuthProfileDTO { get; set; }

    private bool isFastLogin = true;
    private List<string>? Errors { get; set; }
    private UserPopup UserPopupRef = new();


    protected override void OnInitialized()
    {
        AuthProfileDTO = new() { UserName = string.Empty, Password = string.Empty };
        if (isFastLogin)
        {
            AuthProfileDTO.UserName = "creator";
            AuthProfileDTO.Password = "123";
        }
    }

    async Task OnSigninSubmit()
    {
        if (IsSubmissionReady() is false) return;
        string? token = await IdentityService.GetToken(AuthProfileDTO!.UserName, AuthProfileDTO.Password);
        if (token is null)
        {
            DataService.ShowErrorAlert("Trouble with Credentials.");
            return;
        }
        PlayerRequest request = new PlayerRequest() { RequestType = PlayerRequestType.NewPlayer, Token = token };
        PlayerResponse? response = await ApiService.SendRequest<PlayerRequest, PlayerResponse>(Endpoints.User, request);
        if (response?.Response.Status is true)
        {
            DataService?.SetToken(token);
            DataService?.SetPlayerName(response.PlayerName!);
            NavMgr.NavigateTo(PageLink.Portfolio);
        }
    }

    @* async Task SigninSubmitAsync()
    {
        if (IsSubmissionReady() is false) return;
        ProfileRequest request = new()
        {
            SigninParameters = ProfileDTO,
        };
        ProfileResponse? response = await ApiService.SendRequest<ProfileRequest, ProfileResponse>(Endpoints.Signin, request);
        if (response is null) return;
        Signin(response.UserDTO, response.Token);
    } *@
    bool IsSubmissionReady()
    {
        Errors = [];
        Errors.CheckStringEntry(AuthProfileDTO?.UserName, "User Name", 20, 3);
        Errors.CheckStringEntry(AuthProfileDTO?.Password, "Password", 20, 3);
        return (Errors.Count == 0);
    }
    void RegisterClicked()
    {
        AuthProfileDTO dto = new() { UserName = string.Empty, Password=string.Empty };
        UserPopupRef?.Show(dto);
    }
    async Task RegisterSubmit(AuthProfileDTO dto)
    {
        string? token = await IdentityService.RegisterNewUser(dto);
        if (token is null)
        {
            DataService.ShowErrorAlert("Trouble Registering.");
            return;
        }
        UserPopupRef.Close();
        PlayerRequest request = new () {
            RequestType = PlayerRequestType.NewPlayer,
            Token = token
        };
        PlayerResponse? response = await ApiService.SendRequest<PlayerRequest, PlayerResponse>(Endpoints.User, request);
         if (response?.Response.Status is true) {   DataService?.SetToken(token);
            DataService?.SetPlayerName(dto.UserName);
            NavMgr.NavigateTo(PageLink.Portfolio);
            }
        @* SigninRequest request = new() { RequestType = SigninRequestType.REGISTER, UserDTO = dto };
        SigninResponse? response = await ApiService.SendRequest<SigninRequest, SigninResponse>(Endpoints.Signin, request);
        if (response is null || response.Response.Status == false) return;

        Signin(response.UserDTO, response.Token); *@
    }
    @* void Signin(PlayerDTO? userIdentity, string? Token)
    {
        DataService.SetToken(Token);
        DataService.SetUserDTO(userIdentity);
        if (DataService.IsSuccessfulSignin())
        {
            NavMgr.NavigateTo(PageLink.Portfolio);
        }
    } *@
