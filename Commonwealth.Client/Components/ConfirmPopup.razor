@using Microsoft.AspNetCore.Components;

@namespace Commonwealth.Client.Components

@if (IsVisible)
{
    <div class="modal fade show d-block" tab-index="-1" style="background-color: rgba(0,0,0,.6);">
        <div class="modal-dialog @Size modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-5 border border-dark" style="border-radius:20px; background-color: @BGcolor;">
                <div class="modal-header py-0" style="border-bottom-color:Black">
                    <div class="modal-title fw-bold fs-5">Confirm</div>
                    <button type="button" class="btn-close fw-bold" @onclick="Close"></button>
                </div>
                <div class="modal-body my-1">
                    @if (@Message is not null)
                    {
                        @Message
                    }
                </div>
                <div class="modal-footer">
                    @if (TextFalse is not null)
                    {
                        <button type="button" class="btn btn-danger" @onclick="(() => OnSelectionAsync(false))">@TextFalse</button>
                    }
                    @if (TextTrue is not null)
                    {
                        <button type="button" class="btn btn-success" @onclick="(() => OnSelectionAsync(true))">@TextTrue</button>
                    }
                </div>
            </div>
        </div>
    </div>
}
@code
{
    [Parameter] public Action<bool, object?>? Callback { get; set; }
    [Parameter] public Func<bool, object?, Task>? CallbackAsync { get; set; }
    //   [Parameter] public Action<object?>? ConfirmCallback { get; set; }
    [Parameter] public string? TextTrue { get; set; } = "Confirm";
    [Parameter] public string? TextFalse { get; set; } = "Cancel";
    [Parameter] public string Size { get; set; } = "";
    [Parameter] public string BGcolor { get; set; } = "Cornsilk";

    bool IsVisible = false;
    string? Message { get; set; }
    Object? OptionalObject { get; set; }


    public void Show(string? message, Object? obj = null)
    {
        Message = message;
        OptionalObject = obj;
        IsVisible = true;
        StateHasChanged();
    }

    public void Close()
    {
        IsVisible = false;
        StateHasChanged();
    }
    public async Task OnSelectionAsync(bool disposition)
    {
        Close();
        if (CallbackAsync is not null)
        {
            await InvokeAsync(() => CallbackAsync(disposition, OptionalObject));
        }
        else
        {
            Callback?.Invoke(disposition, OptionalObject);
        }
    }
}
