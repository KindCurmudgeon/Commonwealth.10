    bool IsSubmissionReady()
    {
        Errors = [];
        Errors.CheckStringEntry(UserDTO!.UserName, "User Name", 20, 3);
        if (IsNewUser) Errors.CheckStringEntry(UserDTO!.Password, "Password", 20, 3);
        Errors.CheckForEmailAddress(UserDTO.Email);
        return (Errors.Count == 0);
    }
    public void Close()
    {
        IsVisible = false;
        StateHasChanged();
    }
    public void UpdateUserDTO(UserDTO? dto)
    {
        if (dto is null) return;
        UserDTO = dto;
        StateHasChanged();
    }


