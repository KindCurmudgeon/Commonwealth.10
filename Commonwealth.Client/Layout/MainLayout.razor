@using Commonwealth.Client.Services;
@using Commonwealth.Shared.EndpointDTOs;
@using Commonwealth.Client.Components;

@inherits LayoutComponentBase

@inject NavigationManager NavMgr;
@inject SharedDataService DataService;
@inject ApiService ApiService;

@namespace Commonwealth.Client.Layout

<PageTitle>Commonwealth</PageTitle>
<div class="container-fluid">
    <div class="row px-2 py-0 my-0 py-0" style="background-color:black">
        <div class="text-center py-0 my-0">
            <img src="TitleBar.png" class="w-50 py-0 my-0" @onclick="() => ForDev()"></img>
        </div>
    </div>
    @if (DataService.UserIdentity is not null)
    {
        <div class="row px-2 py-0 my-0" style="background-color:black">
            <div class="col text-start">
                <span class="text-warning">User ID:</span>
                <span class="text-info"><b>@DataService.UserIdentity.UserName</b></span>
            </div>
            <div class="col text-center">
                <div class="text-center text-warning clicktext" @onclick="Reshow">Show Last Alert</div>
            </div>
            <div class="col text-end">
                <div class="text-warning text-end clicktext" @onclick="Logout" role="button">Logout</div>
            </div>
            }
        </div>
    }
    <article class="content px-2">
        @Body
    </article>
    <AlertPopup @ref="AlertPopup" />
    <ReportPopup @ref="ReportPopupRef" />
</div>
@code {
    public ReportPopup ReportPopupRef { get; set; } = new();
    private AlertPopup AlertPopup = new();
    private ResponseBase? lastResponse;

    protected override void OnInitialized()
    {
        DataService.SetMainLayout(this);
        DataService.SetApiService(ApiService);
        ApiService.SetDataService(DataService);
        DataService.NavMgr = NavMgr;
    }

    public void ShowAlert(ResponseBase responseBase)
    {
        lastResponse = responseBase;
        AlertPopup.Show(responseBase, 1);
    }
    public void Reshow()
    {
        if (lastResponse is null) return;
        AlertPopup.Show(lastResponse);
    }

    private void Logout()
    {
        DataService.SetPlayerIdentity(null);
        DataService.SetToken(null);
        NavMgr.NavigateTo(PageLink.Splash);
    }
